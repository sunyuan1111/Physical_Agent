# OpenAI-compatible LLM configuration
#
# Volcengine Ark / Doubao example. Do not commit real API keys.
GPT_URL=https://ark.cn-beijing.volces.com/api/v3
GPT_KEY=<ark key>
GPT_MODEL=doubao-seed-2.1-pro

# If your Ark resource uses an inference endpoint id, GPT_MODEL may be ep-xxxx.
#
# Reasoning / deep-thinking is enabled by default when the provider supports it.
# OpenAI Responses API uses the official reasoning parameter.
# Chat Completions-compatible providers can receive provider-specific thinking
# options through extra_body. For Ark / Doubao, configure a JSON object such as:
#
# GPT_REASONING_EXTRA_BODY={"thinking":{"type":"enabled"}}
#
# Optional overrides:
# GPT_API_MODE=chat_completions
# GPT_API_MODE=responses
# GPT_REASONING_ENABLED=true
# GPT_REASONING_EFFORT=medium
# GPT_REASONING_SUMMARY=auto

{
  "name": "physical-agent-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "physical-agent-tui": "./dist/main.js"
  },
  "scripts": {
    "start": "tsx src/main.tsx",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
